<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EmissiveColors>
        <EmissiveColor>
            <Id>
                <TypeId>MyObjectBuilder_EmissiveColorDefinition</TypeId>
                <SubtypeId>MW_NeonOrange</SubtypeId>
            </Id>
            <ColorDefinition>
                <R>255</R>
                <G>90</G>
                <B>0</B>
                <A>255</A>
            </ColorDefinition>
        </EmissiveColor>
    </EmissiveColors>
    <EmissiveColorStatePresets>
        <!-- Every state is the same full-bright neon orange, so the Emissive parts never change with power or damage. -->
        <EmissiveColorStatePreset>
            <Id>
                <TypeId>MyObjectBuilder_EmissiveColorStatePresetDefinition</TypeId>
                <SubtypeId>MW_NeonOrange_Constant</SubtypeId>
            </Id>
            <EmissiveStates>
                <EmissiveState StateName="Damaged" EmissiveColorName="MW_NeonOrange" DisplayColorName="White" Emissivity="1" />
                <EmissiveState StateName="Disabled" EmissiveColorName="MW_NeonOrange" DisplayColorName="White" Emissivity="1" />
                <EmissiveState StateName="Working" EmissiveColorName="MW_NeonOrange" DisplayColorName="White" Emissivity="1" />
                <EmissiveState StateName="Warning" EmissiveColorName="MW_NeonOrange" DisplayColorName="White" Emissivity="1" />
                <EmissiveState StateName="Alternative" EmissiveColorName="MW_NeonOrange" DisplayColorName="White" Emissivity="1" />
            </EmissiveStates>
        </EmissiveColorStatePreset>
    </EmissiveColorStatePresets>
</Definitions>
