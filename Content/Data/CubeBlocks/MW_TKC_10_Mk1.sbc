<?xml version="1.0" ?>
<!--
	TEMPLATE: WeaponCore turret block.
	Replace every WEAPON_ID with the block SubtypeId (e.g. MW_TKC_10_Mk1)
	and WEAPON_NAME with the name shown in the G menu.
	Save the filled copy as Content\Data\CubeBlocks\WEAPON_ID.sbc.
	Defaults below are for a 1x1x1 large-grid block mounted from the bottom.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<!-- WeaponCore weapons use the ConveyorSorter type. Keep both the xsi:type and the TypeId. -->
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>MW_TKC_10_Mk1</SubtypeId> <!-- Must match SubtypeId in the weapon .cs -->
			</Id>
			<DisplayName>TKC-10 Mk1</DisplayName>
			<Description>Optional Text Here</Description>
			<Icon>Textures\GUI\Icons\Cubes\MW_TKC_10_Mk1.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1" /> <!-- Block size in cubes. Mount points below are in the same units. -->
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\Cubes\large\MW_TKC_10_Mk1.mwm</Model> <!-- Base model only; the Azimuth/Elevation subparts are loaded through the model's subpart empties. -->
			<Components>
				<!-- Order matters: components are installed top to bottom as the block is built. Repeating a type (e.g. SteelPlate first and last) is allowed. -->
				<Component Subtype="SteelPlate" Count="10" />
				<Component Subtype="Construction" Count="10" />
				<Component Subtype="Motor" Count="5" />
				<Component Subtype="LargeTube" Count="2" />
				<Component Subtype="Computer" Count="5" />
				<Component Subtype="SteelPlate" Count="10" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" /> <!-- The block stops working once this component is damaged. -->
			<MountPoints>
				<!-- Coordinates are in cubes on each face, from 0 to the block's size on that face. Enabled="false" shows the face as non-mountable. -->
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" />
				<!-- <MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" Enabled="false"/> -->
				<!-- <MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" Enabled="false"/> -->
				<!-- <MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" Enabled="false"/> -->
				<!-- <MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" Enabled="false"/> -->
				<!-- <MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00" Enabled="false"/> -->
			</MountPoints>
			<InventorySize>
				<!-- Inventory volume in cubic metres (X*Y*Z). WeaponCore overrides it with InventorySize in the weapon .cs. -->
				<X>0.5</X>
				<Y>1</Y>
				<Z>1</Z>
			</InventorySize>
			<BlockPairName>MW_TKC_10_Mk1</BlockPairName>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>25</BuildTimeSeconds>
			<WeaponDefinitionId Subtype="MW_TKC_10_Mk1" /> <!-- Links the block to its WeaponCore definition -->
			<ResourceSinkGroup>Defense</ResourceSinkGroup> <!-- Power priority group -->
		</Definition>
	</CubeBlocks>
</Definitions>
