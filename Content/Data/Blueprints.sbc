    <Blueprints>
        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>MW_Anvil_S1_AmmoBP</SubtypeId>
            </Id>
            <DisplayName>Anvil S1 Shell</DisplayName>
            <Icon>Textures\GUI\Icons\Ammo\MW_Anvil_S1_Ammo.dds</Icon>
            <Prerequisites>
                <Item Amount="70" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="20" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="5" TypeId="Ingot" SubtypeId="Cobalt" />
