            </Prerequisites>
            <Result Amount="1" TypeId="AmmoMagazine" SubtypeId="MW_Anvil_S1_AmmoMag" />
            <BaseProductionTimeInSeconds>10</BaseProductionTimeInSeconds>
        </Blueprint>

